<section class="relative overflow-hidden border-b border-white/5">
  <div class="container-page grid items-center gap-12 py-16 md:grid-cols-2 md:py-28">
    <div class="reveal">
      <p class="eyebrow mb-5">Est. Johannesburg &mdash; Small-Batch Grooming</p>
      <h1 class="font-display text-4xl leading-[1.1] text-bone sm:text-5xl md:text-6xl">
        Refine your beard.
        <span class="block italic text-gold-bright">Elevate your presence.</span>
      </h1>
      <p class="mt-6 max-w-md text-base leading-relaxed text-stone md:text-lg">
        Beard Gloss strengthens and gives shine to hair — so you walk into the room already put together.
      </p>

      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <a href="/product/beard-gloss" class="btn-gold">
          Shop Now
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <a href="/product/beard-gloss#details" class="btn-outline">Why It Works</a>
      </div>

      <div class="mt-10 flex items-center gap-6 text-xs text-stone">
        <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>Free delivery over R500</span>
        <span class="flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-gold"></span>30-day guarantee</span>
      </div>
    </div>

    <div class="reveal mx-auto w-full max-w-xs overflow-hidden rounded-sm md:max-w-sm">
      <img
        src="/images/product/beard-gloss-lineup.jpg"
        alt="Man holding the BeardGloss pouch beside the full five-scent Hair & Beard Oil lineup"
        class="h-auto w-full object-cover"
        width="1011"
        height="1516"
      />
    </div>
  </div>

  <div class="pour-rule"></div>
</section>
