---
const galleryImages = [
  {
    src: '/images/product/beard-gloss-collection-dark.jpg',
    alt: 'The Beard Gloss collection — five scent variants lined up against a dark backdrop',
  },
  {
    src: '/images/product/beard-gloss-collection-cream.jpg',
    alt: 'The Beard Gloss collection styled with packaging on a cream backdrop',
  },
  {
    src: '/images/product/beard-gloss-main.jpg',
    alt: 'BeardGloss pouch, front label detail',
  },
  {
    src: '/images/product/beard-gloss-lifestyle.jpg',
    alt: 'Man holding BeardGloss pouch against the Johannesburg skyline',
  },
];
---

<section class="border-b border-white/5 bg-charcoal/40">
  <div class="container-page py-16 md:py-24">
    <p class="eyebrow reveal mb-3">Gallery</p>
    <h2 class="reveal mb-10 max-w-lg text-3xl text-bone md:text-4xl">
      A closer look at the collection.
    </h2>

    <div class="grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6">
      {galleryImages.map((img, i) => (
        <button
          type="button"
          class="reveal card group overflow-hidden cursor-zoom-in text-left"
          style={`transition-delay:${i * 80}ms`}
          data-gallery-trigger
          data-full-src={img.src}
          data-full-alt={img.alt}
          aria-label={`Enlarge image: ${img.alt}`}
        >
          <img
            src={img.src}
            alt={img.alt}
            loading="lazy"
            class="aspect-[3/4] h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox overlay -->
  <div
    id="gallery-lightbox"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/95 p-4 md:p-10"
    role="dialog"
    aria-modal="true"
    aria-label="Enlarged gallery image"
  >
    <button
      type="button"
      id="gallery-lightbox-close"
      class="absolute right-4 top-4 flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-bone transition-colors hover:border-gold hover:text-gold-bright md:right-8 md:top-8"
      aria-label="Close enlarged image"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </button>
    <img
      id="gallery-lightbox-img"
      src=""
      alt=""
      class="max-h-full max-w-full rounded-md object-contain shadow-gold"
    />
  </div>
</section>

<script>
  function initGalleryLightbox() {
    const overlay = document.getElementById('gallery-lightbox');
    const overlayImg = document.getElementById('gallery-lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('gallery-lightbox-close');
    const triggers = document.querySelectorAll<HTMLElement>('[data-gallery-trigger]');
    if (!overlay || !overlayImg || !closeBtn || !triggers.length) return;

    let lastFocused: HTMLElement | null = null;

    const openLightbox = (trigger: HTMLElement) => {
      const src = trigger.getAttribute('data-full-src') || '';
      const alt = trigger.getAttribute('data-full-alt') || '';
      overlayImg.src = src;
      overlayImg.alt = alt;
      lastFocused = trigger;
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.classList.add('overflow-hidden');
      closeBtn.focus();
    };

    const closeLightbox = () => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      overlayImg.src = '';
      document.body.classList.remove('overflow-hidden');
      lastFocused?.focus();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => openLightbox(trigger));
    });

    closeBtn.addEventListener('click', closeLightbox);

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !overlay.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initGalleryLightbox);
</script>
